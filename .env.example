# Copy to .env if you run services outside Docker
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding?schema=public
JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000

# Email (SMTP). Без SMTP_HOST листи не шлються.
# Для локального дебагу без SMTP: EMAIL_LOG=1 — логи в консоль API.
# EMAIL_LOG=1
# EMAIL_FROM=NITKA <noreply@nitka.ua>
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=resend
# SMTP_PASS=

# Uploads: без Cloudinary — локальна папка apps/api/uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=nitka
# PUBLIC_API_URL=http://localhost:3001
