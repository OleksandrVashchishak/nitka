# Local. Copy into apps/api/.env and apps/web/.env.local
# or run: npm run local:setup
#
#   npm run local:setup
#   npm run local:install
#   npm run local:db
#   npm run local:migrate
#   npm run local:seed   # optional
#   npm run api          # terminal 1
#   npm run web          # terminal 2
#
# Postgres: winget install PostgreSQL.PostgreSQL.16 --override "--mode unattended --superpassword wedding --serverport 5432 --disable-components stackbuilder"

# --- apps/api/.env ---
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding?schema=public
JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081
PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
EMAIL_LOG=1
SUPERADMIN_EMAIL=admin
SUPERADMIN_PASSWORD=1234
# ADMIN_NOTIFY_EMAIL=admin@example.com

# --- apps/web/.env.local ---
# API_URL=http://localhost:3001
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (SMTP). Без SMTP_HOST листи не шлються.
# EMAIL_FROM=fata.studio <noreply@fata.studio>
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=resend
# SMTP_PASS=

# Email на період тестування: безкоштовний Gmail (~500 листів/добу).
# Потрібна 2FA в акаунті + App Password: https://myaccount.google.com/apppasswords
# EMAIL_FROM має збігатися з SMTP_USER, інакше Gmail підмінить відправника.
# EMAIL_FROM=fata.studio <your.name@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=your.name@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# Підтвердження email при реєстрації вмикається само, коли заданий SMTP_HOST. Вимкнути: EMAIL_VERIFICATION=0

# Uploads: без Cloudinary — локальна папка apps/api/uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=fata

# Render API (опційно, для агентів / ops: логи, деплої).
# Створити: dashboard.render.com → Account Settings → API Keys
# Клади лише в apps/api/.env (gitignore) — ніколи в git.
# RENDER_API_KEY=

